namespace Faithful.Archive
open Formalism.BasicNotions Formalism.MainNotions

/-- The rational equality expressed in the base record's own spaces. -/
theorem basePeriod (D : D7) (h : D.BuRational) (u : D.what₂.Word)
    (φ : (D.div.Nu u).V) (x : D.div.RR.V) :
    D.what₂.Bu u (D.jN u φ) (D.jEE x) = D.what₂.embLL (D.div.Bk u φ x) :=
  h u φ x

/-- Transfer the selected window estimate to twisted-place divisibility
at the indices of this same family. -/
theorem windowToTwisted {eps : ℝ} (Fm : FamP eps) (heps : 0 < eps)
    (window : UpperTheory.Top.HypV Fm.toFamCore) (localComparison : LinkN Fm)
    (ranks : SmallLevelRankEq Fm) : DIVinN Fm :=
  UpperTheory.Top.divinN_of_hypV Fm heps window localComparison ranks

/-- The final implication after the all-character nonvanishing input. -/
theorem terminalFromCharacters (h : UpperTheory.EveryCharacter) : RiemannHypothesis :=
  Formalism.VW.rh_of_every h

end Faithful.Archive

